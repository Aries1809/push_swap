+
+/* True if a is sorted except for a rotation (like 3 4 0 1 2):
+ * then bringing the smallest to the top is enough. */
+static bool	is_rotated_sorted(t_stack *s)
+{
+	t_node		*n;
+	uint64_t	breaks;
+
+	breaks = 0;
+	n = s->top;
+	while (n->next)
+	{
+		if (n->index > n->next->index)
+			breaks++;
+		n = n->next;
+	}
+	if (s->bot->index > s->top->index)
+		breaks++;
+	return (breaks <= 1);
+}
+
+/* Position of the element with a rank below limit that is
+ * cheapest to rotate to the top of a. */
+static uint64_t	cheapest_below(t_stack *a, uint64_t limit)
+{
+	t_node		*n;
+	uint64_t	i;
+	uint64_t	best;
+
+	n = a->top;
+	i = 0;
+	best = a->size;
+	while (n)
+	{
+		if (n->index < limit && (best == a->size
+				|| cost_to_top(a, i) < cost_to_top(a, best)))
+			best = i;
+		n = n->next;
+		i++;
+	}
+	return (best);
+}
+
+/* Sorts 4 or 5 elements: pushes the 1 or 2 smallest to b (cheapest
+ * first), sorts the 3 left in a, and pushes them back on top. */
+void	sort_five(t_ps *ps)
+{
+	uint64_t	limit;
+
+	if (is_rotated_sorted(&ps->a))
+		return (bring_to_top(ps, &ps->a, pos_of(&ps->a, 0)));
+	limit = ps->a.size - 3;
+	while (ps->a.size > 3)
+	{
+		bring_to_top(ps, &ps->a, cheapest_below(&ps->a, limit));
+		ps_op(ps, OP_PB);
+	}
+	sort_three(ps);
+	if (ps->b.size == 2 && ps->b.top->index < ps->b.top->next->index)
+		ps_op(ps, OP_SB);
+	while (ps->b.size > 0)
+		ps_op(ps, OP_PA);
+}
